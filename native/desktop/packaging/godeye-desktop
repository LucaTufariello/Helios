#!/usr/bin/env bash
# Keep the Qt private RHI libraries and plugins with the binary that used them.
set -euo pipefail
godeye_launcher="$(readlink -f -- "${BASH_SOURCE[0]}")"
godeye_package="$(cd -- "$(dirname -- "$godeye_launcher")" && pwd)"
if [[ "$(uname -s)" != Linux || "$(uname -m)" != x86_64 ]]; then
  printf 'This GodEye package requires Linux x86_64.\n' >&2
  exit 1
fi
export LD_LIBRARY_PATH="$godeye_package/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$godeye_package/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$godeye_package/plugins/platforms"
# Host desktop theme plugins can use a different Qt private ABI. Qt's built-in
# style remains available, with the app's own light/dark palette.
unset QT_QPA_PLATFORMTHEME QT_STYLE_OVERRIDE
if [[ "${1:-}" == --check-runtime ]]; then
  godeye_failed=0
  while IFS= read -r -d '' godeye_elf; do
    godeye_dependencies="$(ldd "$godeye_elf" 2>&1)" || godeye_failed=1
    if [[ "$godeye_dependencies" == *'not found'* ]]; then
      printf '%s\n%s\n' "$godeye_elf" "$godeye_dependencies" >&2
      godeye_failed=1
    fi
    if [[ "$godeye_dependencies" == *libQt6* ]]; then
      while IFS= read -r godeye_line; do
        if [[ "$godeye_line" == *libQt6* && "$godeye_line" != *"$godeye_package/lib/"* ]]; then
          printf 'Qt library resolved outside this package: %s\n' "$godeye_line" >&2
          godeye_failed=1
        fi
      done <<< "$godeye_dependencies"
    fi
  done < <(find "$godeye_package/bin" "$godeye_package/plugins" -type f \( -name 'GodEyeDesktop' -o -name 'ffmpeg' -o -name '*.so' \) -print0)
  if [[ "$godeye_failed" == 0 ]]; then
    printf 'GodEye runtime dependencies resolve; Qt libraries use %s/lib.\n' "$godeye_package"
    printf 'The host supplies Vulkan/OpenGL drivers, ICDs, fonts, certificates and its graphical session.\n'
  fi
  exit "$godeye_failed"
fi
exec "$godeye_package/bin/GodEyeDesktop" "$@"
